<section class="tab {{tab.cssClass}}" data-tab="effect" data-group="primary">
  <div class="st-strip {{#if effectStrip.broken}}st-broken{{/if}}">
    <i class="fa-solid {{effectStrip.icon}} st-strip-icon" inert></i>
    <div class="st-strip-text">
      <strong>{{effectStrip.title}}</strong>
      <span class="st-muted">{{effectStrip.sub}}</span>
    </div>
    <div class="st-strip-actions">
      {{#if effectStrip.broken}}
      <button type="button" class="st-danger" data-action="repairLinks"><i class="fa-solid fa-wrench" inert></i> {{localize "SARGAS_TRAPZORS.Config.RepairLinks"}}</button>
      {{/if}}
      <button type="button" data-action="previewEffect" {{#unless hasEffectArea}}disabled{{/unless}}>
        <i class="fa-solid fa-eye" inert></i> {{localize "SARGAS_TRAPZORS.Config.Preview"}}
      </button>
      <button type="button" data-action="placeEffect" {{#unless editable}}disabled{{/unless}}>
        <i class="fa-solid fa-draw-polygon" inert></i> {{effectStrip.placeLabel}}
      </button>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "SARGAS_TRAPZORS.Config.Shape.label"}}</label>
    <div class="form-fields">
      <div class="st-segmented" role="radiogroup" aria-label="{{localize "SARGAS_TRAPZORS.Config.Shape.label"}}">
        {{#each shapes}}<label><input type="radio" name="effect.shape" value="{{value}}" {{#if selected}}checked{{/if}}><span>{{label}}</span></label>{{/each}}
      </div>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "SARGAS_TRAPZORS.Config.Anchor.label"}}</label>
    <div class="form-fields">
      <div class="st-segmented" role="radiogroup" aria-label="{{localize "SARGAS_TRAPZORS.Config.Anchor.label"}}">
        {{#each anchors}}<label><input type="radio" name="effect.anchor" value="{{value}}" {{#if selected}}checked{{/if}}><span>{{label}}</span></label>{{/each}}
      </div>
    </div>
    <p class="hint">{{anchorHint}}</p>
  </div>
  <div class="form-group">
    <label for="st-reveal-seconds">{{localize "SARGAS_TRAPZORS.Config.RevealSeconds"}}</label>
    <div class="form-fields">
      <input id="st-reveal-seconds" type="number" name="effect.revealSeconds" value="{{v.effect.revealSeconds}}" min="0" step="any">
      <span class="st-muted">{{localize "SARGAS_TRAPZORS.Config.RevealSecondsUnit"}}</span>
    </div>
  </div>
  <div class="form-group">
    <label for="st-anim">{{localize "SARGAS_TRAPZORS.Animation.label"}}</label>
    <div class="form-fields">
      <select id="st-anim" name="effect.animation.preset">
        {{#each animation.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        {{#each animation.groups}}
        <optgroup label="{{label}}">
          {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}
        </optgroup>
        {{/each}}
        <option value="custom" {{#if animation.isCustom}}selected{{/if}}>{{localize "SARGAS_TRAPZORS.Animation.Custom"}}</option>
      </select>
      <button type="button" data-action="previewAnimation">
        <i class="fa-solid fa-film" inert></i> {{localize "SARGAS_TRAPZORS.Animation.Preview"}}
      </button>
      {{#if animation.sva}}
      <button type="button" data-action="browseSva" {{#unless editable}}disabled{{/unless}}>
        <i class="fa-solid fa-magnifying-glass" inert></i> {{localize "SARGAS_TRAPZORS.Animation.BrowseSva"}}
      </button>
      {{/if}}
    </div>
    <p class="hint">{{localize "SARGAS_TRAPZORS.Animation.Hint"}}{{#unless animation.hasJb2a}} <span class="st-muted">{{localize "SARGAS_TRAPZORS.Animation.NoJb2a"}}</span>{{/unless}}</p>
  </div>
  {{#if animation.isCustom}}
  <div class="form-group">
    <label for="st-anim-file">{{localize "SARGAS_TRAPZORS.Animation.File"}}</label>
    <div class="form-fields">
      <input id="st-anim-file" type="text" name="effect.animation.file" value="{{animation.file}}">
      <button type="button" class="icon fa-solid fa-file-video" data-action="browseAnimation" data-tooltip="SARGAS_TRAPZORS.Animation.Browse" aria-label="{{localize "SARGAS_TRAPZORS.Animation.Browse"}}"></button>
    </div>
  </div>
  {{#if animation.needsSva}}
  <p class="notification warning st-notice">{{localize "SARGAS_TRAPZORS.Animation.DbPathHint"}}</p>
  {{/if}}
  <div class="form-group">
    <label for="st-anim-mode">{{localize "SARGAS_TRAPZORS.Animation.Mode.label"}}</label>
    <div class="form-fields">
      <select id="st-anim-mode" name="effect.animation.mode">
        {{#each animation.modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
  </div>
  {{/if}}
  {{#if animation.sva}}
  <div class="form-group">
    <label for="st-anim-persist">{{localize "SARGAS_TRAPZORS.Animation.Persist"}}</label>
    <div class="form-fields">
      <input id="st-anim-persist" type="checkbox" name="effect.animation.persist" {{#if animation.persist}}checked{{/if}}>
    </div>
    <p class="hint">{{localize "SARGAS_TRAPZORS.Animation.PersistHint"}}</p>
  </div>
  {{/if}}
  <div class="form-group">
    <label for="st-walls">{{localize "SARGAS_TRAPZORS.Config.BlockedByWalls"}}</label>
    <div class="form-fields">
      <input id="st-walls" type="checkbox" name="effect.blockedByWalls" {{#if v.effect.blockedByWalls}}checked{{/if}}>
    </div>
    <p class="hint">{{localize "SARGAS_TRAPZORS.Config.BlockedByWallsHint"}}</p>
  </div>
</section>
